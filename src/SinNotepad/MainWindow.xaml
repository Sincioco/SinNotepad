<Window x:Class="SinNotepad.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sin - Notepad" Width="1016" Height="625" MinWidth="560" MinHeight="320" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterScreen" Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" AllowDrop="True" PreviewKeyDown="WindowKeyDown" Drop="WindowDrop" DragOver="WindowDragOver" Closing="WindowClosing" Activated="WindowActivated">
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition x:Name="TabRow" Height="39"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="1" x:Name="HorizontalNavigation" Margin="8,6,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ListBox x:Name="Tabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}" ItemContainerStyle="{StaticResource TabItemStyle}" ItemTemplate="{StaticResource DocumentTemplate}" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="NavigationSelectionChanged" PreviewMouseLeftButtonDown="NavigationMouseDown" PreviewMouseMove="NavigationMouseMove" PreviewMouseDown="NavigationMiddleClick" PreviewKeyDown="NavigationKeyDown" ContextMenuOpening="NavigationContextMenuOpening" AllowDrop="True" Drop="NavigationDrop" AutomationProperties.Name="Tabs"><ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
    <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="10" Style="{StaticResource FlatButton}" Click="NewTabClick" ToolTip="New tab (Ctrl+N)" AutomationProperties.Name="New tab" Margin="2,0,0,2"/>
  </Grid>
  <Border Grid.Row="0" Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center" Margin="4,0,84,0" Foreground="{DynamicResource TextBrush}" PreviewMouseDown="MenuPreviewMouseDown">
   <MenuItem Header="_File" Template="{StaticResource CompactMenuHeader}">
    <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewTabClick"/>
    <MenuItem Header="New _window" InputGestureText="Ctrl+Shift+N" Click="NewWindowClick"/>
    <MenuItem Header="_Open" InputGestureText="Ctrl+O" Click="OpenClick"/>
    <MenuItem x:Name="RecentMenu" Header="_Recently Opened" SubmenuOpened="RecentOpened">
     <MenuItem Header="No recently opened files" IsEnabled="False"/>
    </MenuItem>
    <Separator/><MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveClick"/>
    <MenuItem Header="Save _as" InputGestureText="Ctrl+Shift+S" Click="SaveAsClick"/>
    <MenuItem Header="Save a_ll" InputGestureText="Ctrl+Alt+S" Click="SaveAllClick"/>
    <Separator/><MenuItem Header="_Close tab" InputGestureText="Ctrl+W" Click="CloseTabClick"/>
    <MenuItem Header="Close window" InputGestureText="Ctrl+Shift+W" Click="WindowCloseClick"/>
    <MenuItem Header="E_xit" Click="ExitClick"/>
   </MenuItem>
   <MenuItem Header="_Edit" Template="{StaticResource CompactMenuHeader}" SubmenuOpened="EditOpened">
    <MenuItem x:Name="UndoMenu" Header="_Undo" InputGestureText="Ctrl+Z" Click="UndoClick"/>
    <MenuItem x:Name="RedoMenu" Header="_Redo" InputGestureText="Ctrl+Y" Click="RedoClick"/>
    <Separator/><MenuItem x:Name="CutMenu" Header="Cu_t" InputGestureText="Ctrl+X" Click="CutClick"/>
    <MenuItem x:Name="CopyMenu" Header="_Copy" InputGestureText="Ctrl+C" Click="CopyClick"/>
    <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="PasteClick"/>
    <MenuItem x:Name="DeleteMenu" Header="De_lete" InputGestureText="Del" Click="DeleteClick"/>
    <Separator/><MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="FindClick"/>
    <MenuItem Header="Find next" InputGestureText="F3" Click="FindNextClick"/>
    <MenuItem Header="Find previous" InputGestureText="Shift+F3" Click="FindPreviousClick"/>
    <MenuItem Header="R_eplace" InputGestureText="Ctrl+H" Click="ReplaceClick"/>
    <MenuItem Header="_Go to" InputGestureText="Ctrl+G" Click="GoToClick"/>
    <Separator/><MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="SelectAllClick"/>
    <MenuItem x:Name="DateTimeMenu" Header="_Date/Time" InputGestureText="F5" SubmenuOpened="DateTimeOpened"><MenuItem Header="Choose a format"/></MenuItem>
    <MenuItem Header="Insert _separator (80 underscores)" InputGestureText="Ctrl+L" Click="InsertSeparatorClick"/>
    <MenuItem Header="_Insert date/time and separator" InputGestureText="Ctrl+I" Click="InsertDateAndSeparatorClick"/>
   </MenuItem>
   <MenuItem Header="_View" Template="{StaticResource CompactMenuHeader}" SubmenuOpened="ViewOpened">
    <MenuItem Header="_Zoom"><MenuItem Header="Zoom in" InputGestureText="Ctrl+Plus" Click="ZoomInClick"/><MenuItem Header="Zoom out" InputGestureText="Ctrl+Minus" Click="ZoomOutClick"/><MenuItem Header="Restore default zoom" InputGestureText="Ctrl+0" Click="ResetZoomClick"/></MenuItem>
    <MenuItem x:Name="StatusBarMenu" Header="_Status bar" IsCheckable="True" Click="StatusBarClick"/>
    <MenuItem x:Name="LineNumbersMenu" Header="_Line numbers" IsCheckable="True" Click="LineNumbersClick"/>
    <MenuItem x:Name="WordWrapMenu" Header="_Word wrap" IsCheckable="True" Click="WordWrapClick"/>
    <Separator/><MenuItem x:Name="DocumentListMenu" Header="_Document List" IsCheckable="True" InputGestureText="Ctrl+Shift+L" Click="DocumentListClick"/>
   </MenuItem>
  </Menu><Button HorizontalAlignment="Right" Margin="0,2,5,2" Content="&#xE713;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Width="32" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings"/></Grid></Border>
  <Border x:Name="SearchPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FindBox" MinWidth="120" MaxWidth="440" HorizontalAlignment="Stretch" AutomationProperties.Name="Find text" TextChanged="SearchChanged" PreviewKeyDown="FindBoxKeyDown"/><Button Grid.Column="1" Content="↑" Style="{StaticResource FlatButton}" Click="FindPreviousClick" ToolTip="Find previous (Shift+F3)" AutomationProperties.Name="Find previous"/><Button Grid.Column="2" Content="↓" Style="{StaticResource FlatButton}" Click="FindNextClick" ToolTip="Find next (F3)" AutomationProperties.Name="Find next"/><Button Grid.Column="3" Content="&#xE713;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Click="FindOptionsClick" ToolTip="Search options" AutomationProperties.Name="Search options"/><Button Grid.Column="4" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Click="CloseSearchClick" ToolTip="Close (Esc)" AutomationProperties.Name="Close search"/></Grid>
   <StackPanel x:Name="SearchOptions" Orientation="Horizontal" Margin="4,8,0,0" Visibility="Collapsed"><CheckBox x:Name="MatchCase" Content="Match case" Margin="0,0,20,0" Click="SearchOptionChanged"/><CheckBox x:Name="WholeWord" Content="Match whole word" Margin="0,0,20,0" Click="SearchOptionChanged"/><CheckBox x:Name="WrapSearch" Content="Wrap around" IsChecked="True"/></StackPanel>
   <Grid x:Name="ReplacePanel" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReplaceBox" AutomationProperties.Name="Replace with" MaxWidth="440" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Replace" Margin="8,0,0,0" Click="ReplaceOneClick"/><Button Grid.Column="2" Content="Replace all" Margin="8,0,0,0" Click="ReplaceAllClick"/></Grid>
   <TextBlock x:Name="SearchStatus" Margin="4,5,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></Border>
  <Grid x:Name="Workspace" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="0"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
   <Border x:Name="DocumentPane" Visibility="Collapsed" Background="{DynamicResource ShellBrush}"><DockPanel>
    <Grid DockPanel.Dock="Top" Height="40" Margin="12,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><TextBlock Text="Document List" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11" Style="{StaticResource FlatButton}" Click="NewTabClick" ToolTip="New tab (Ctrl+N)" AutomationProperties.Name="New document"/><Button Grid.Column="2" Content="Tabs" FontSize="11" Style="{StaticResource FlatButton}" Click="DocumentListClick" ToolTip="Switch to tabs (Ctrl+Shift+L)" AutomationProperties.Name="Switch to tabs"/></Grid>
    <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument,Mode=TwoWay}" ItemTemplate="{StaticResource DocumentTemplate}" ItemContainerStyle="{StaticResource DocumentItemStyle}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="NavigationSelectionChanged" PreviewMouseLeftButtonDown="NavigationMouseDown" PreviewMouseMove="NavigationMouseMove" PreviewMouseDown="NavigationMiddleClick" PreviewKeyDown="NavigationKeyDown" ContextMenuOpening="NavigationContextMenuOpening" Drop="NavigationDrop" AllowDrop="True" AutomationProperties.Name="Document List"><ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu></ListBox>
   </DockPanel></Border>
   <GridSplitter x:Name="DocumentSplitter" Grid.Column="1" Visibility="Collapsed" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource LineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="SplitterDragCompleted" Focusable="True" KeyboardIncrement="10" ToolTip="Drag to resize the Document List" AutomationProperties.Name="Resize Document List"/>
   <Grid Grid.Column="2" Background="{DynamicResource EditorBrush}"><ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/><Border x:Name="ExternalNotice" Visibility="Collapsed" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Top" Padding="12,8"><DockPanel><Button Content="Reload" DockPanel.Dock="Right" Click="ReloadClick" Margin="8,0"/><Button Content="Keep my version" DockPanel.Dock="Right" Click="KeepVersionClick" Margin="8,0"/><TextBlock x:Name="ExternalMessage" Text="This file changed outside Sin - Notepad." VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border></Grid>
  </Grid>
  <Border x:Name="StatusBar" Grid.Row="4" Height="30" Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="154"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PositionStatus" Text="Ln 1, Col 1" Style="{StaticResource StatusText}" MinWidth="72"/><TextBlock x:Name="CountStatus" Grid.Column="1" Text="0 characters" Style="{StaticResource StatusText}"/><Button x:Name="ZoomStatus" Grid.Column="2" Content="120%" Style="{StaticResource FlatButton}" FontSize="11" Click="ResetZoomClick" ToolTip="Reset zoom to 100%"/><Button x:Name="NewlineStatus" Grid.Column="3" Content="Windows (CRLF)" Style="{StaticResource FlatButton}" FontSize="11" Click="NewlineClick" ToolTip="Line endings"/><Button x:Name="EncodingStatus" Grid.Column="4" Content="UTF-8" Style="{StaticResource FlatButton}" FontSize="11" Click="EncodingClick" ToolTip="Text encoding"/>
  </Grid></Border>
 </Grid></Border>
</Window>
